# \begin{}...\end{}
snippet begin \begin{} ... \end{} block
	\\begin{${1:env}}
		${0:${VISUAL}}
	\\end{$1}

# Itemize
snippet item itemize environment
	\\begin{itemize}
		\\item ${0}
	\\end{itemize}

snippet it \item
	\\item ${1:${VISUAL}}

snippet rit Rightarrow \item
    \\item[\\(\\Rightarrow\\)] 

snippet sec Section
    \\section{${0}}

snippet subsec Subsection
    \\subsection{${0}}

snippet arr arrow
    \\(\rightarrow\\)

snippet Arr Double arrow
    \\(\Rightarrow\\)

# Equation
snippet ieq inline equation
		\(${0}\)

snippet eq equation environment
	\\begin{align*}
        ${0}
	\\end{align*}

snippet fr equation environment
    \\frac{${1}}{${2}}

# Gls
snippet gls Glossaries 
	\gls{${0}}

snippet Gls Glossaries 
	\Gls{${0}}

# Enumerate
snippet enum enumerate environment
	\\begin{enumerate}
		\\item ${0}
	\\end{enumerate}

# Figure
snippet figi figure environment (includegraphics)
	\\begin{figure}
		\\centering
		\\resizebox{\\textwidth}{!}{\\includegraphics[scale=${1}]{${2}}}
        \\caption{${3}}
        \\label{fig:${4}}
	\\end{figure}
	${0}

snippet fig figure environment (input)
	\\begin{figure}[h]
		\\centering
		\\resizebox{\\textwidth}{!}{\\input{${1}}}
        \\caption{${3}}
        \\label{fig:${4}}
	\\end{figure}
	${0}

# Table
snippet tab tabular environment
    \begin{tabular}{ c c }
         Head 1 & Head 2  \\\\ 
         Row 1  & ABC     \\\\   
    \end{tabular}

# Frame
snippet fra frame environment
    \\begin{frame}[t]{${0}}
        ${1}
    \\end{frame}

snippet col columns environment
    \\begin{columns}
        \\begin{column}[t]{0.5\\textwidth}
        ${1}
        \\end{column}
        \\begin{column}[t]{0.5\\textwidth}
            
        \\end{column}
    \\end{columns}

# Misc
snippet par paragraph
    \par

# Formatting
snippet rm mathrm
    \mathrm{${0}}

snippet tbf bold
    \textbf{${0}}

snippet tit italics
    \textit{${0}}

